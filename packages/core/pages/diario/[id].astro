---
import { entryUrl } from '../../lib/collections.mjs';
import { getCollection, render } from 'astro:content';
import config from 'virtual:cronache/config';
import EntryLayout from '../../layouts/EntryLayout.astro';
import SessionLoot from '../../components/SessionLoot.astro';
import { ogImage } from '../../lib/og';
import { imageSize, sessionArt } from '../../lib/portraits';
import { toRoman, longDate } from '../../lib/format';

export async function getStaticPaths() {
  const sessions = (await getCollection('sessions')).sort((a, b) => a.data.numero - b.data.numero);
  return sessions.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: sessions[i - 1], next: sessions[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const art = sessionArt(entry.id);
const artSize = art ? imageSize(art) : undefined;
---
<EntryLayout
  title={entry.data.titolo}
  description={entry.data.estratto}
  meta={`${config.labels.session} ${toRoman(entry.data.numero)} · ${longDate(entry.data.data)}`}
  tags={entry.data.tag}
  collection="sessions"
  id={entry.id}
  og={ogImage(entry.data)}
>
  {art && <img slot="header" class="entry-frontispiece" src={art} alt="" width={artSize?.width} height={artSize?.height} />}
  <Content />
  <SessionLoot loot={entry.data.bottino} />
  <nav slot="after" class="entry-pager" aria-label={config.labels.otherSessions}>
    {prev && (
      <a href={entryUrl('sessions', prev.id)}>&larr; {toRoman(prev.data.numero)}. {prev.data.titolo}</a>
    )}
    {next && (
      <a class="entry-pager-next" href={entryUrl('sessions', next.id)}>{toRoman(next.data.numero)}. {next.data.titolo} &rarr;</a>
    )}
  </nav>
</EntryLayout>
