---
import config from 'virtual:cronache/config';
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, heading, lede, description, placeholder } = config.sections.cerca;
---
<BaseLayout title={title} description={description}>
  <style is:inline>
    /* In a layer so the site rules beat Pagefind's inflated specificity. */
    @import url('/pagefind/pagefind-component-ui.css') layer(pagefind);
  </style>
  <h1 class="page-title">{heading}</h1>
  <p class="page-lede">{lede}</p>

  <div class="search">
    <pagefind-input placeholder={placeholder} autofocus></pagefind-input>
    <div class="search-bar">
      <pagefind-summary></pagefind-summary>
      <pagefind-filter-dropdown filter="sezione" label="Sezione" hide-clear></pagefind-filter-dropdown>
    </div>
    <pagefind-results show-sub-results></pagefind-results>
    <p class="search-unavailable" hidden>
      Indice di ricerca non disponibile: viene generato solo da <code>pnpm build</code>
      (provalo con <code>pnpm preview</code>).
    </p>
  </div>

  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  <script is:inline type="module">
    const pagefind = window.PagefindComponents;
    if (!pagefind) {
      document.querySelector('.search-unavailable').hidden = false;
    } else {
      const instance = pagefind.getInstanceManager().getInstance('default');
      // The stock Italian translation renders clear_search as "Cancella la cronologia".
      instance.setTranslations({ clear_search: 'Cancella' });
      const q = new URLSearchParams(location.search).get('q');
      if (q) instance.triggerSearch(q);

      // Results arrive on every keystroke: only a query left standing for a moment counts.
      let term = '';
      let sent = '';
      let timer;
      instance.on('search', (t) => { term = t; });
      instance.on('results', (r) => {
        clearTimeout(timer);
        const query = term.trim();
        if (!query || query === sent) return;
        const results = r.results.length;
        timer = setTimeout(() => {
          sent = query;
          window.umami?.track('search', { query, results });
        }, 1000);
      });
    }
  </script>
</BaseLayout>
