---
import { getEntry, render } from 'astro:content';
import config from 'virtual:cronache/config';
import EntryLayout from '../layouts/EntryLayout.astro';

const entry = await getEntry('riassunto', 'overview');
const { Content } = await render(entry);
---
<EntryLayout
  title={entry.data.titolo}
  description={config.sections.riassunto.description}
  collection="riassunto"
  id={entry.id}
>
  <Content />
</EntryLayout>
