---
import config from 'virtual:cronache/config';
import '../styles/base.css';
import 'virtual:cronache/styles';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LinkPreview from '../components/LinkPreview.astro';
import { defaultOgImage, type OgImage } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  masthead?: boolean;
  og?: OgImage;
}
const siteName = config.name;
const { title, description = config.description, type = 'website', masthead = false, og = defaultOgImage } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(og.src, Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {og.type && <meta property="og:image:type" content={og.type} />}
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content={og.large ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={og.alt} />
  </head>
  <body>
    <Header masthead={masthead}>
      <slot name="masthead" slot="masthead" />
    </Header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <LinkPreview />
  </body>
</html>
