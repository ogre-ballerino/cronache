---
import config from 'virtual:cronache/config';
import BaseLayout from './BaseLayout.astro';
import Backlinks from '../components/Backlinks.astro';
import SearchHighlight from '../components/SearchHighlight.astro';
import { collectionByKey, entryUrl } from '../lib/collections.mjs';
import { imageSize } from '../lib/portraits';
import { isAlive, isLost } from '../lib/status.mjs';
import type { OgImage } from '../lib/og';

interface Props {
  title: string;
  description?: string;
  meta?: string;
  status?: string;
  tags?: string[];
  collection: string;
  id: string;
  image?: string;
  og?: OgImage;
}
const { title, description, meta, tags = [], collection, id, image, og } = Astro.props;
const status = isAlive(Astro.props.status) ? undefined : Astro.props.status;
const size = image ? imageSize(image) : undefined;

const section = config.sections[collectionByKey(collection)!.section as keyof typeof config.sections].label;
---
<BaseLayout title={title} description={description} type="article" og={og}>
  <article data-pagefind-body data-pagefind-filter={section && `sezione:${section}`}>
    <header class="entry-header">
      {image && (
        <img class:list={['entry-image', { 'portrait-lost': isLost(status) }]} src={image} alt={title} width={size?.width} height={size?.height} />
      )}
      <h1 class="page-title" data-pagefind-weight="10">{title}</h1>
      {meta && <p class="entry-meta" data-pagefind-ignore>{meta}</p>}
      {(status || tags.length > 0) && (
        <div class="badge-row" data-pagefind-ignore>
          {status && <span class={`badge badge-${status}`}>{status}</span>}
          {tags.map((t) => <span class="badge">{t}</span>)}
        </div>
      )}
      <slot name="header" />
    </header>
    <div class="entry-content">
      <slot />
    </div>
    <div data-pagefind-ignore>
      <Backlinks url={entryUrl(collection, id)} />
      <slot name="after" />
    </div>
  </article>
  <SearchHighlight />
</BaseLayout>
