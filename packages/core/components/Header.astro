---
import config from 'virtual:cronache/config';

interface Props {
  masthead?: boolean;
}
const { masthead = false } = Astro.props;
const { about } = config;

const path = Astro.url.pathname;
const isWithin = (href: string) => path === href.slice(0, -1) || path.startsWith(href);
// The "?" travels with the last entry, so a wrapping nav never leaves it alone on a line.
const links = config.nav.slice(0, -1);
const last = config.nav.at(-1)!;
---
<header class:list={['site-header', { 'site-header-masthead': masthead }]}>
  {masthead ? (
    <slot name="masthead" />
  ) : (
    <a href="/" class="site-header-title" set:html={config.headerTitle} />
  )}
  <nav class="site-nav" aria-label="Navigazione principale">
    {links.map((l) => (
      <a href={l.href} aria-current={isWithin(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    {about ? (
      <span class="site-nav-end">
        <a href={last.href} aria-current={isWithin(last.href) ? 'page' : undefined}>{last.label}</a>
        <button type="button" class="site-about-toggle" popovertarget="site-about" aria-label={about.label}>?</button>
      </span>
    ) : (
      <a href={last.href} aria-current={isWithin(last.href) ? 'page' : undefined}>{last.label}</a>
    )}
  </nav>
  {about && (
    <div id="site-about" class="site-about" popover>
      <button type="button" class="site-about-close" popovertarget="site-about" popovertargetaction="hide" aria-label="Chiudi">×</button>
      <h2>{about.title}</h2>
      <div set:html={about.html} />
    </div>
  )}
</header>
