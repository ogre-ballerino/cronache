---
import config from 'virtual:cronache/config';
import { getBacklinksFor } from '../lib/backlinks';
import { enabledCollections } from '../lib/collections.mjs';
import { toRoman } from '../lib/format';

interface Props {
  url: string;
}
const { url } = Astro.props;
const backlinks = (await getBacklinksFor(url)).toSorted((a, b) => (a.numero ?? 0) - (b.numero ?? 0));

// The riassunto mentions nearly everything, so it's left out.
const sections = enabledCollections(config.features)
  .filter((c) => !c.single)
  .map((c) => {
    const section: { label: string; backlinks?: string } = config.sections[c.section as keyof typeof config.sections];
    return {
      label: section.backlinks ?? section.label,
      sessions: c.key === 'sessions',
      links: backlinks.filter((l) => l.collection === c.key),
    };
  })
  .filter((s) => s.links.length > 0);
---
{sections.length > 0 && (
  <div class="backlinks">
    <h2>{config.labels.mentionedIn}</h2>
    <dl>
      {sections.map((s) => (
        <>
          <dt>{s.label}</dt>
          <dd>
            <ul class:list={{ 'backlinks-sessions': s.sessions }}>
              {s.links.map((link) =>
                link.numero ? (
                  <li>
                    <a href={link.url} aria-label={`${config.labels.session} ${toRoman(link.numero)}: ${link.title}`}>
                      {toRoman(link.numero)}
                    </a>
                  </li>
                ) : (
                  <li><a href={link.url}>{link.title}</a></li>
                )
              )}
            </ul>
          </dd>
        </>
      ))}
    </dl>
  </div>
)}
