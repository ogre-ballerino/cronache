---
import { isLost } from '../lib/status';

interface Props {
  href: string;
  title: string;
  excerpt?: string;
  meta?: string;
  status?: string;
  image?: string;
}
const { href, title, excerpt, meta, image } = Astro.props;
const status = ['vivo', 'viva'].includes(Astro.props.status ?? '') ? undefined : Astro.props.status;
---
<a class="card" href={href}>
  {image && <img class:list={['card-image', { 'portrait-lost': isLost(status) }]} src={image} alt="" loading="lazy" />}
  <h3>{title}</h3>
  {meta && <p class="entry-meta">{meta}</p>}
  {excerpt && <p>{excerpt}</p>}
  {status && (
    <div class="badge-row">
      <span class={`badge badge-${status}`}>{status}</span>
    </div>
  )}
</a>
