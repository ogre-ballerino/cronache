---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { toRoman, longDate } from '../lib/format';
import { fullPortrait } from '../lib/portraits';
import { groupBySeason } from '../lib/seasons';
import { isLost } from '../lib/status';
import { nextSession } from '../lib/site';

const sessions = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const latest = sessions[0];
const seasons = groupBySeason(sessions);

const characters = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const party = characters.filter((p) => fullPortrait(p.id));
const castRows = [
  party.filter((p) => !isLost(p.data.stato)),
  party.filter((p) => isLost(p.data.stato)),
].filter((row) => row.length > 0);

const nextDate = new Date(`${nextSession}Z`);
const nextLabel = [
  nextDate.toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }),
  nextDate.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }),
].join(' alle ');
---
<BaseLayout masthead>
  {nextDate.getTime() > Date.now() && (
    <p class="next-session" id="next-session" data-at={nextSession}>
      Prossima sessione: {nextLabel}
    </p>
  )}

  <script>
    const item = document.getElementById('next-session');
    if (item && new Date(item.dataset.at!).getTime() < Date.now()) item.hidden = true;
  </script>

  {latest && (
    <section class="latest-session">
      <p class="kicker kicker-split">
        <span>Ultimo capitolo · {toRoman(latest.data.numero)}</span>
        <span>{longDate(latest.data.data)}</span>
      </p>
      <h2><a href={`/diario/${latest.id}`}>{latest.data.titolo}</a></h2>
      {latest.data.estratto && <p class="drop-cap">{latest.data.estratto}</p>}
      <p class="read-more"><a href={`/diario/${latest.id}`}>Continua a leggere</a></p>
    </section>
  )}

  {party.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Gli investigatori</h2>
      {castRows.map((row) => (
        <div class="cast-grid">
          {row.map((p) => (
            <a class="cast-portrait" href={`/personaggi/${p.id}`}>
              <img class:list={{ 'portrait-lost': isLost(p.data.stato) }} src={fullPortrait(p.id)} alt="" loading="lazy" />
              <span>{p.data.titolo}</span>
              {p.data.sottotitolo && <span class="cast-subtitle">{p.data.sottotitolo}</span>}
              {!['vivo', 'viva'].includes(p.data.stato) && <span class={`badge badge-${p.data.stato}`}>{p.data.stato}</span>}
            </a>
          ))}
        </div>
      ))}
    </section>
  )}

  {party.length === 0 && characters.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Dramatis personae</h2>
      <ul class="dramatis">
        {characters.map((p) => (
          <li>
            <a href={`/personaggi/${p.id}`}>{p.data.titolo}</a>
            {p.data.professione && <span> {p.data.professione}</span>}
            {!['vivo', 'viva'].includes(p.data.stato) && <span class={`badge badge-${p.data.stato}`}> {p.data.stato}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {sessions.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Capitoli</h2>
      {seasons.map(({ stagione, sessions }) => (
        <>
          <h3 class="season-heading">Stagione {toRoman(stagione)}</h3>
          <ol class="session-index">
            {sessions.map((s) => (
              <li>
                <span class="session-index-number">{toRoman(s.data.numero)}</span>
                <a href={`/diario/${s.id}`}>{s.data.titolo}</a>
                <span class="session-index-leader" aria-hidden="true"></span>
                <span class="session-index-date">
                  {s.data.data.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })}
                </span>
              </li>
            ))}
          </ol>
        </>
      ))}
    </section>
  )}
</BaseLayout>
