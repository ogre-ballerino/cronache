---
import BaseLayout from '@cronache/core/layouts/BaseLayout.astro';
import { entryUrl } from '@cronache/core/lib/collections.mjs';
import { getCollection } from 'astro:content';
import { getSlugMap, normalize } from '@cronache/core/lib/wikilinks.mjs';
import { contentDir } from 'virtual:cronache/paths';

const places = await getCollection('luoghi');
const byId = Object.fromEntries(places.map((l) => [l.id, l]));

const slugMap = getSlugMap(contentDir);
const sessions = await getCollection('sessions');
const visitedUrls = new Set<string>();
for (const s of sessions) {
  for (const name of s.data.luoghiVisitati) {
    const target = slugMap.get(normalize(name));
    if (target?.collection === 'luoghi') visitedUrls.add(target.url);
    else console.warn(`[mappa] luoghiVisitati in ${s.id}: "${name}" is not a place`);
  }
}

// Woodcut background (public/images/mappe/barovia.webp) recut from the valley's
// map, in 1920x1080 coordinates: forests, water and relief only. Only places the
// party knows about get a pin and a name, and only known roads are drawn: the
// landscape stays unlabelled to avoid spoilers.
const W = 1920;
const H = 1080;

type P = [number, number];

const nodes = [
  { id: 'villaggio-di-barovia', x: 1545, y: 660 },
  { id: 'castello-ravenloft', x: 1384, y: 546, large: true },
  { id: 'vallaki', x: 761, y: 351 },
  { id: 'torre-abbandonata', x: 427, y: 283 },
  { id: 'wizard-of-wines', x: 176, y: 506 },
  { id: 'argynvostholt', x: 650, y: 662 },
  { id: 'accampamento-dei-vistani', x: 1320, y: 672, labelBelow: true },
]
  .map((n) => ({ ...n, entry: byId[n.id] }))
  .filter((n) => n.entry);

// Where the party is now: the last pinned place in the latest session's
// luoghiVisitati, which lists places in the order the group reached them.
const latest = sessions.reduce((a, b) => (b.data.numero > a.data.numero ? b : a));
const hereId = latest.data.luoghiVisitati
  .map((name) => slugMap.get(normalize(name))?.url)
  .reverse()
  .map((url) => nodes.find((n) => entryUrl('luoghi', n.id) === url)?.id)
  .find(Boolean);

// Traced along the roads of the valley's map (the trails to the Wizard of Wines
// and Argynvostholt are dotted on it), between the places and crossroads.
const travelledRoads: P[][] = [
  // From the gate in the east, past the Village of Barovia and Tser Pool, up to Vallaki
  [[1907, 596], [1807, 597], [1786, 618], [1769, 648], [1747, 670], [1731, 676], [1680, 680], [1542, 680], [1518, 684], [1492, 716], [1458, 770], [1434, 791], [1399, 793], [1374, 766], [1366, 763], [1339, 763], [1320, 776], [1309, 778], [1299, 791], [1277, 809], [1243, 810], [1228, 795], [1213, 768], [1213, 755], [1223, 737], [1222, 689], [1206, 672], [1189, 671], [1150, 712], [1113, 730], [1106, 730], [1094, 718], [1087, 704], [1091, 698], [1102, 694], [1126, 673], [1141, 667], [1160, 665], [1167, 658], [1167, 624], [1193, 595], [1199, 560], [1190, 554], [1155, 553], [1141, 539], [1146, 522], [1160, 507], [1160, 493], [1154, 484], [1124, 454], [1090, 456], [1078, 439], [1063, 426], [1053, 426], [1030, 438], [1007, 465], [988, 467], [980, 458], [980, 446], [986, 435], [987, 425], [981, 419], [971, 419], [962, 425], [958, 423], [958, 399], [971, 389], [993, 387], [1005, 396], [1024, 398], [1052, 370], [1067, 363], [1075, 355], [1078, 338], [1072, 332], [1052, 331], [1038, 339], [1023, 339], [1010, 332], [1000, 332], [985, 343], [955, 347], [913, 368], [909, 368], [909, 364], [899, 357], [895, 368], [875, 368], [832, 356], [761, 351]],
  // Vallaki → the crossroads by Lake Baratok → the Wizard of Wines
  [[761, 351], [698, 354], [675, 364], [646, 379], [614, 411], [586, 446], [560, 453], [535, 453], [508, 431], [497, 427], [484, 414], [471, 390], [453, 372], [440, 364], [414, 362], [395, 366], [381, 365], [376, 360], [370, 360], [363, 367], [328, 373], [316, 384], [311, 395], [311, 415], [304, 427], [297, 433], [278, 440], [265, 451], [260, 485], [254, 494], [241, 496], [210, 478], [190, 479], [186, 484], [176, 506]],
  // Vallaki → over the bridge on the Luna, then south down the overgrown trail to Argynvostholt
  [[761, 351], [698, 354], [653, 376], [646, 383], [669, 408], [672, 416], [673, 431], [666, 462], [666, 481], [673, 495], [680, 525], [679, 569], [671, 582], [667, 610], [658, 631], [659, 643], [647, 653], [647, 659]],
  // The trail down to the Vistani camp on Tser Pool
  [[1181, 621], [1197, 639], [1209, 647], [1249, 649], [1258, 653], [1264, 661], [1260, 688], [1275, 705], [1320, 672]],
];

const knownRoads: P[][] = [
  // The road up to Castle Ravenloft
  [[1160, 500], [1181, 502], [1208, 473], [1224, 473], [1248, 497], [1268, 498], [1281, 484], [1291, 482], [1296, 490], [1292, 512], [1315, 536], [1331, 537], [1346, 551], [1374, 551]],
  // The Old Svalich Road west, out of the valley
  [[376, 360], [349, 335], [300, 335], [272, 326], [250, 326], [224, 343], [209, 344], [189, 331], [120, 321], [46, 300], [11, 300]],
  // Out to the tower on Lake Baratok
  [[410, 365], [426, 362], [436, 345], [458, 331], [456, 318], [446, 309], [427, 283]],
  // South, over the pass
  [[410, 365], [410, 411], [406, 421], [386, 453], [343, 493], [340, 500], [340, 512], [354, 536], [355, 558], [336, 576], [316, 585], [296, 587], [277, 609], [267, 643], [279, 651], [287, 642], [289, 630], [305, 615], [314, 615], [337, 637], [350, 641], [376, 641], [397, 623], [423, 626], [431, 635], [431, 645], [426, 655], [429, 687], [389, 719], [382, 733], [382, 746], [393, 755], [408, 757], [430, 781], [439, 784], [448, 798], [447, 810], [457, 819], [467, 823], [507, 822], [532, 844], [543, 847], [561, 870], [559, 911], [579, 932], [581, 943], [596, 958], [612, 967], [645, 965], [662, 985], [676, 995], [707, 998], [719, 1011], [718, 1026], [733, 1027], [728, 1035]],
];

const r1 = (n: number) => Math.round(n * 10) / 10;

function smooth(pts: P[]) {
  const p = [pts[0], ...pts, pts[pts.length - 1]];
  let d = `M${p[1][0]},${p[1][1]}`;
  for (let i = 1; i < p.length - 2; i++) {
    const [p0, a, b, p3] = [p[i - 1], p[i], p[i + 1], p[i + 2]];
    const c1 = [a[0] + (b[0] - p0[0]) / 6, a[1] + (b[1] - p0[1]) / 6];
    const c2 = [b[0] - (p3[0] - a[0]) / 6, b[1] - (p3[1] - a[1]) / 6];
    d += ` C${r1(c1[0])},${r1(c1[1])} ${r1(c2[0])},${r1(c2[1])} ${b[0]},${b[1]}`;
  }
  return d;
}

---
<BaseLayout
  title="Mappa di Barovia"
  description="La mappa di Barovia con i luoghi raggiunti dalla compagnia e le strade già percorse."
  og={{ src: '/images/mappe/og.png', alt: 'La mappa di Barovia incisa a xilografia', type: 'image/png', width: 1200, height: 630, large: true }}
>
  <h1 class="page-title">Mappa di Barovia</h1>
  <p class="page-lede">
    La mappa della valle, annotata con le tappe che il gruppo ha raggiunto o
    di cui ha sentito parlare.
  </p>

  <div class="map-wrap">
    <svg class="map-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title" xmlns="http://www.w3.org/2000/svg">
      <title id="map-title">Mappa di Barovia con i luoghi incontrati dal gruppo</title>
      <defs>
        <radialGradient id="castle-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#7a1f2b" stop-opacity="0.55" />
          <stop offset="100%" stop-color="#7a1f2b" stop-opacity="0" />
        </radialGradient>
        <filter id="fog" x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.009" numOctaves="3" seed="5" />
          <feDisplacementMap in="SourceGraphic" scale="110" />
          <feGaussianBlur stdDeviation="16" />
        </filter>
      </defs>

      <rect width={W} height={H} class="map-paper" />
      <image href="/images/mappe/barovia.webp" width={W} height={H} preserveAspectRatio="none" />

      {[...knownRoads, ...travelledRoads].map((s) => (
        <path d={smooth(s)} class="map-road-casing" />
      ))}
      {knownRoads.map((s) => (
        <path d={smooth(s)} class="map-road-known" />
      ))}
      {travelledRoads.map((s) => (
        <path d={smooth(s)} class="map-road-travelled" />
      ))}

      <rect x="-40" y="-40" width={W + 80} height={H + 80} class="map-fog" filter="url(#fog)" />

      <g transform="translate(1790 150)" class="map-compass">
        <circle r="46" class="map-compass-ring" />
        <path d="M0,-70 L10,-10 L0,0 Z M0,70 L-10,10 L0,0 Z M-70,0 L-10,-10 L0,0 Z M70,0 L10,10 L0,0 Z" class="map-compass-filled" />
        <path d="M0,-70 L-10,-10 L0,0 Z M0,70 L10,10 L0,0 Z M-70,0 L-10,10 L0,0 Z M70,0 L10,-10 L0,0 Z" class="map-compass-hollow" />
        <text y="-80" text-anchor="middle" class="map-compass-north">N</text>
      </g>

      {nodes.map((n) => {
        const visited = visitedUrls.has(entryUrl('luoghi', n.id));
        const title = n.entry!.data.titolo;
        const r = n.large ? 18 : 13;
        const labelWidth = title.length * 14.5 + 32;
        // Kept inside the frame; below the pin when a neighbour's label sits above.
        const labelX = Math.min(W - 30 - labelWidth / 2, Math.max(30 + labelWidth / 2, n.x));
        const labelY = n.labelBelow ? n.y + r + 14 : n.y - r - 56;
        return (
          <a href={entryUrl('luoghi', n.id)} class="map-pin-link">
            {n.large && <circle cx={n.x} cy={n.y} r={r * 4} fill="url(#castle-glow)" />}
            {n.id === hereId && (
              <g class="map-here">
                <circle cx={n.x} cy={n.y} r={r + 12} class="map-here-ring" />
                <circle cx={n.x} cy={n.y} r={r + 20} class="map-here-ring map-here-ring-outer" />
              </g>
            )}
            <circle
              cx={n.x}
              cy={n.y}
              r={r}
              class:list={['map-pin', { 'map-pin-large': n.large, 'map-pin-visited': visited, 'map-pin-unknown': !visited }]}
            />
            <rect
              x={labelX - labelWidth / 2}
              y={labelY}
              width={labelWidth}
              height="42"
              rx="4"
              class="map-pin-label-bg"
            />
            <text
              x={labelX}
              y={labelY + 30}
              class:list={['map-pin-label', { 'map-pin-label-unknown': !visited }]}
              text-anchor="middle"
            >
              {title}
            </text>
          </a>
        );
      })}
    </svg>
  </div>
  <p class="map-hint">Trascina la mappa per esplorare la valle.</p>

  <div class="map-legend">
    <span class="map-legend-item"><span class="map-legend-dot map-legend-dot-visited" aria-hidden="true"></span>Visitato</span>
    <span class="map-legend-item"><span class="map-legend-dot map-legend-dot-unknown" aria-hidden="true"></span>Conosciuto, non visitato</span>
    {hereId && (
      <span class="map-legend-item"><span class="map-legend-dot map-legend-dot-here" aria-hidden="true"></span>La compagnia, ora</span>
    )}
    <span class="map-legend-item"><span class="map-legend-line map-legend-line-travelled" aria-hidden="true"></span>Strada percorsa</span>
    <span class="map-legend-item"><span class="map-legend-line map-legend-line-known" aria-hidden="true"></span>Altre strade</span>
  </div>

  <p class="map-footnote">
    Le tappe interne a Vallaki (locanda, chiesa, bottega, villa del
    borgomastro) non compaiono qui singolarmente: sono elencate nella
    pagina di <a href="/luoghi/vallaki/">Vallaki</a>. Elenco completo dei
    luoghi in <a href="/luoghi/">Luoghi</a>.
  </p>
</BaseLayout>
