---
import BaseLayout from '@cronache/core/layouts/BaseLayout.astro';
import { entryUrl } from '@cronache/core/lib/collections.mjs';
import NextSession from '@cronache/core/components/NextSession.astro';
import SessionIndex from '@cronache/core/components/SessionIndex.astro';
import { getCollection } from 'astro:content';
import { toRoman, longDate } from '@cronache/core/lib/format';
import { fullPortrait } from '@cronache/core/lib/portraits';

const sessions = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const latest = sessions[0];

const characters = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const party = characters.filter((p) => fullPortrait(p.id));
---
<BaseLayout masthead>
  <Fragment slot="masthead">
    <p class="masthead-kicker">diario di campagna</p>
    <h1 class="masthead-title">La Maledizione<br /><em>di</em> Strahd</h1>
  </Fragment>

  <NextSession />

  {latest && (
    <section class="latest-session">
      <p class="kicker kicker-split">
        <span>Ultima sessione · {toRoman(latest.data.numero)}</span>
        <span>{longDate(latest.data.data)}</span>
      </p>
      <h2><a href={entryUrl('sessions', latest.id)}>{latest.data.titolo}</a></h2>
      {latest.data.estratto && <p class="drop-cap">{latest.data.estratto}</p>}
      <p class="read-more"><a href={entryUrl('sessions', latest.id)}>Continua a leggere</a> &rarr;</p>
    </section>
  )}

  {party.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#8258;</div>
      <h2 class="section-title">La compagnia</h2>
      <div class="cast-grid">
        {party.map((p) => (
          <a class="cast-portrait" href={entryUrl('personaggi', p.id)}>
            <img src={fullPortrait(p.id)} alt="" loading="lazy" />
            <span>{p.data.titolo}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="ornament" aria-hidden="true">&#8258;</div>
    <h2 class="section-title">Indice delle sessioni</h2>
    <SessionIndex sessions={sessions} />
  </section>
</BaseLayout>
