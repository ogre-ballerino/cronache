---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={['door', 'door-busy', className]} role="button" tabindex="0" aria-label="Chiudi la porta" aria-disabled="true">
  <div class="door-frame">
    <div class="door-leaf">
      <span class="door-panel"></span>
      <span class="door-panel"></span>
      <span class="door-knob"></span>
    </div>
  </div>
  <div class="door-spill"></div>
  <div class="door-floor"></div>
  <svg class="door-tentacles" viewBox="0 0 120 220" preserveAspectRatio="xMinYMid meet">
    <defs>
      <linearGradient id="door-flesh" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#24352a" />
        <stop offset=".55" stop-color="#0b120d" />
        <stop offset="1" stop-color="#040705" />
      </linearGradient>
    </defs>
    <path class="door-tentacle" d="M0 40 C 25 34, 50 26, 70 34 C 92 43, 100 66, 88 78 C 80 86, 68 82, 70 74 C 71 69, 77 69, 78 73 C 80 66, 72 58, 62 54 C 46 48, 26 50, 0 56 Z" />
    <g class="door-suckers">
      <circle cx="22" cy="53" r="1.9" /><circle cx="36" cy="51" r="1.7" /><circle cx="50" cy="51" r="1.5" /><circle cx="61" cy="55" r="1.3" /><circle cx="69" cy="61" r="1.1" />
    </g>
    <path class="door-tentacle" d="M0 104 C 30 96, 64 100, 88 118 C 106 132, 114 156, 104 168 C 98 175, 88 172, 90 164 C 91 159, 97 160, 97 164 C 102 152, 96 136, 80 126 C 58 114, 30 118, 0 122 Z" />
    <g class="door-suckers">
      <circle cx="22" cy="119" r="2.1" /><circle cx="40" cy="118" r="1.9" /><circle cx="57" cy="120" r="1.7" /><circle cx="72" cy="126" r="1.5" /><circle cx="85" cy="135" r="1.3" /><circle cx="93" cy="146" r="1.1" />
    </g>
    <path class="door-tentacle" d="M0 186 C 20 180, 40 184, 56 196 C 66 204, 80 210, 92 204 C 98 200, 96 194, 92 196 C 86 200, 74 198, 62 190 C 44 178, 22 190, 0 194 Z" />
    <g class="door-suckers">
      <circle cx="18" cy="190" r="1.3" /><circle cx="32" cy="188" r="1.2" /><circle cx="46" cy="190" r="1.1" /><circle cx="60" cy="196" r="1" />
    </g>
  </svg>
</div>

<script>
  // The door can be shut, but not for long: after a moment of dark it creaks open again.
  // It ignores clicks while it moves (on arrival too): shutting it mid-swing would make the leaf jump.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SHUT_FOR = 3000;
  const SWING_FOR = still ? 0 : 4200;

  for (const door of document.querySelectorAll<HTMLElement>('.door')) {
    const setBusy = (busy: boolean) => {
      door.classList.toggle('door-busy', busy);
      door.setAttribute('aria-disabled', String(busy));
    };
    const shut = () => {
      if (door.classList.contains('door-busy')) return;
      setBusy(true);
      door.classList.add('door-closed');
      setTimeout(() => {
        door.classList.remove('door-closed');
        setTimeout(() => setBusy(false), SWING_FOR);
      }, SHUT_FOR);
    };
    setTimeout(() => setBusy(false), SWING_FOR);
    door.addEventListener('click', shut);
    door.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      shut();
    });
  }
</script>
