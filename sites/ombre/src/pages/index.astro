---
import BaseLayout from '@cronache/core/layouts/BaseLayout.astro';
import { entryUrl } from '@cronache/core/lib/collections.mjs';
import NextSession from '@cronache/core/components/NextSession.astro';
import SessionIndex from '@cronache/core/components/SessionIndex.astro';
import { getCollection } from 'astro:content';
import config from 'virtual:cronache/config';
import { toRoman, longDate } from '@cronache/core/lib/format';
import { fullPortrait } from '@cronache/core/lib/portraits';
import { isAlive, isLost } from '@cronache/core/lib/status.mjs';
import Sigil from '../components/Sigil.astro';

const sessions = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const latest = sessions[0];

const characters = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const party = characters.filter((p) => fullPortrait(p.id));
const castRows = [
  party.filter((p) => !isLost(p.data.stato)),
  party.filter((p) => isLost(p.data.stato)),
].filter((row) => row.length > 0);
---
<BaseLayout masthead>
  <Fragment slot="masthead">
    <Sigil class="masthead-sigil" />
    <p class="masthead-kicker">Call of Cthulhu</p>
    <h1 class="masthead-title">{config.name}</h1>
    <p class="masthead-lede">Cronaca di quanto vedemmo, e di quanto preferiremmo dimenticare.</p>
  </Fragment>

  <NextSession />

  {latest && (
    <section class="latest-session">
      <p class="kicker kicker-split">
        <span>Ultimo capitolo · {toRoman(latest.data.numero)}</span>
        <span>{longDate(latest.data.data)}</span>
      </p>
      <h2><a href={entryUrl('sessions', latest.id)}>{latest.data.titolo}</a></h2>
      {latest.data.estratto && <p class="drop-cap">{latest.data.estratto}</p>}
      <p class="read-more"><a href={entryUrl('sessions', latest.id)}>Continua a leggere</a></p>
    </section>
  )}

  {party.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Gli investigatori</h2>
      {castRows.map((row) => (
        <div class="cast-grid">
          {row.map((p) => (
            <a class="cast-portrait" href={entryUrl('personaggi', p.id)}>
              <img class:list={{ 'portrait-lost': isLost(p.data.stato) }} src={fullPortrait(p.id)} alt="" loading="lazy" />
              <span>{p.data.titolo}</span>
              {p.data.sottotitolo && <span class="cast-subtitle">{p.data.sottotitolo}</span>}
              {!isAlive(p.data.stato) && <span class={`badge badge-${p.data.stato}`}>{p.data.stato}</span>}
            </a>
          ))}
        </div>
      ))}
    </section>
  )}

  {party.length === 0 && characters.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Dramatis personae</h2>
      <ul class="dramatis">
        {characters.map((p) => (
          <li>
            <a href={entryUrl('personaggi', p.id)}>{p.data.titolo}</a>
            {p.data.professione && <span> {p.data.professione}</span>}
            {!isAlive(p.data.stato) && <span class={`badge badge-${p.data.stato}`}> {p.data.stato}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {sessions.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#10022; &#10022; &#10022;</div>
      <h2 class="section-title">Capitoli</h2>
      <SessionIndex sessions={sessions} />
    </section>
  )}
</BaseLayout>
