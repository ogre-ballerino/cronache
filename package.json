{
  "name": "cronache-monorepo",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:all": "pnpm -r --filter './sites/*' build",
    "dev:strahd": "pnpm --filter strahd dev",
    "build:strahd": "pnpm --filter strahd build",
    "dev:ombre": "pnpm --filter ombre dev",
    "build:ombre": "pnpm --filter ombre build",
    "transcribe": "node scripts/transcribe.mjs",
    "session": "node scripts/session.mjs",
    "test": "pnpm --filter @cronache/core test"
  },
  "optionalDependencies": {
    "parakeet-coreml": "^2.2.0"
  }
}
