{
  "name": "cronache-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm campaigns && wrangler dev",
    "deploy": "pnpm campaigns && wrangler deploy",
    "types": "wrangler types",
    "check": "pnpm campaigns && wrangler types && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "campaigns": "node scripts/campaigns.ts",
    "commands": "node --env-file=.dev.vars scripts/commands.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
