---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { handoutMeta } from '../../lib/handout';

export async function getStaticPaths() {
  const handouts = await getCollection('handout');
  return handouts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<EntryLayout
  title={entry.data.titolo}
  description={entry.data.estratto}
  meta={handoutMeta(entry.data)}
  tags={entry.data.tag}
  backlinksUrl={`/handout/${entry.id}`}
>
  <Content />
</EntryLayout>
